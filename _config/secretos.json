{
  "canal": "secretos",
  "nombre_display": "Secretos del Poder",
  "render": {
    "crf": 28,
    "preset": "ultrafast",
    "audio_k": "128k",
    "res_w": 1920,
    "res_h": 1080,
    "fps": 30,
    "max_clip_dur": 8.0,
    "music_vol": 0.10,
    "speed_range": 0.04,
    "flip_enable": true,
    "workers": 4
  },
  "subtitulos": {
    "font": "Arial",
    "fontsize": 58,
    "max_chars_per_line": 42,
    "primary_color": "&H00FFFFFF",
    "outline_color": "&H00000000",
    "outline": 4,
    "bold": true,
    "margin_v": 70
  },
  "harvester": {
    "default_source": "flow",
    "source_order": [
      "flow",
      "brave"
    ],
    "fallback_personas": "brave",
    "clip_secs": 6,
    "img_w": 1376,
    "img_h": 768,
    "prompt_suffix": "vintage archival documentary photograph, black and white, film grain, high contrast, 1930s-1960s historical style, no text, no letters",
    "ken_burns_flip": false,
    "zoompan": {
      "enabled": true,
      "clip_secs": 6,
      "fps": 30,
      "scale_target": "3840:2160",
      "output_res": "1920x1080",
      "preview_res": "640:360",
      "era_filter": true
    },
    "era_ranges": {
      "bw":      [0, 1939],
      "vintage": [1940, 1989],
      "color":   [1990, 9999]
    }
  },
  "guion": {
    "min_chars": 24500,
    "max_chars": 25500,
    "duracion_min": 27,
    "chars_por_minuto": 900,
    "estructura": "documental_matrimonios"
  },
  "musica": {
    "paths_relativos": [
      "musica.mp3",
      "../musica/musica_v1.mp3",
      "../musica/musica_v2.mp3"
    ]
  },
  "youtube": {
    "channel_id": "",
    "credentials_file": "_jsonytapi/SecretosPoder.json",
    "token_file": "_jsonytapi/tokens/SecretosPoder.pickle"
  }
}
